# CSAP local-first env — copy to .env (never commit .env)
# PostgreSQL (local Docker, no managed subscription)
POSTGRES_USER=csap
POSTGRES_PASSWORD=csap_dev_password_change_me
POSTGRES_DB=csap
POSTGRES_PORT=5432
DATABASE_URL=postgresql://csap:csap_dev_password_change_me@localhost:5432/csap

# Better Auth (password + verification code, fingerprint optional, no facial recognition per PRD 5.18)
BETTER_AUTH_SECRET=change_me_to_32plus_random_chars
BETTER_AUTH_URL=http://api.csap.localhost
# Email sender for verification codes (via Resend)
AUTH_EMAIL_FROM=CSAP <no-reply@csap.local>

# File storage — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=csap-dev
R2_PUBLIC_URL=
# R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Email — Resend
RESEND_API_KEY=
RESEND_FROM=CSAP <no-reply@csap.local>

# Caddy / local host
CADDY_BIN=$HOME/.local/bin/caddy
WEB_PORT=3000
API_PORT=8000
