  "dependencies": {
    "better-auth": "^3.0.0",
    "pg": "^8.12.0",
    "resend": "^4.0.0",
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0"
  }
}
