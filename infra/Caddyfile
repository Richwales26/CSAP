# CSAP local reverse proxy (Caddy)
# Run: caddy run --config infra/Caddyfile --adapter caddyfile
# Hosts everything on this Mac for now. Scale to VPS later by copying this file.
{
	auto_https off
	http_port 80
	https_port 443
}

# Web app (Next.js) — change :3000 when apps/web exists
csap.localhost {
	reverse_proxy localhost:3000
}

# API (Node) — change :8000 when services/api exists
api.csap.localhost {
	reverse_proxy localhost:8000
}
